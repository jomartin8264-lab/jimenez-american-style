rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para saber si el usuario es Administrador con acceso total
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]);
    }

    // PRODUCTOS: Todos pueden ver. Personal autorizado crea/actualiza; SOLO Administradores pueden eliminar prendas
    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // PEDIDOS / VENTAS: Cualquiera crea; Personal autorizado lee/actualiza; SOLO Administradores pueden eliminar ventas
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // CONFIGURACIÓN: Todos pueden leer, solo Administradores pueden modificar
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USUARIOS: Cada usuario gestiona su propio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
