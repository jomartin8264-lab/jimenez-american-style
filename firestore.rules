rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para saber si el usuario es Administrador
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]);
    }

    // PRODUCTOS: Todos pueden ver. Admins gestionan todo y clientes registrados pueden descontar existencias al comprar
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null;
    }

    // PEDIDOS: Cualquiera puede generar su pedido al comprar; solo Admins pueden verlos y gestionarlos en el POS
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // CONFIGURACIÓN: Todos pueden leer, solo Admins pueden modificar
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USUARIOS: Cada usuario gestiona su propio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
