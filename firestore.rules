rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para saber si el usuario es Administrador
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]);
    }

    // PRODUCTOS: Catálogo visible para todos. Empleados y Administradores pueden gestionar existencias y productos
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // PEDIDOS Y VENTAS DE MOSTRADOR: Clientes pueden crear pedidos web; Empleados y Admins gestionan y leen ventas
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // TURNOS DE CAJA (Apertura, Cierres, Arqueo, Feria y Gastos):
    // Todos los usuarios autenticados (cajeros y admin) pueden leer, abrir y cerrar turnos
    // Solo Administradores pueden borrar registros del historial
    match /cash_shifts/{shiftId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // MOVIMIENTOS DE CAJA (por si se usan registros sueltos de feria/gastos):
    match /cash_movements/{movementId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // CONFIGURACIÓN (Tienda, Categorías, Admins, Ticket, Contadores):
    // Todos leen configuración pública; cajeros y admins actualizan contadores de folio y tickets; Admins configuran todo
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin() || request.auth != null;
    }

    // USUARIOS Y PERFILES:
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
