rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para saber si el usuario es Administrador con acceso total
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/config/admins).data.emails.hasAny([request.auth.token.email]);
    }

    // PRODUCTOS: Todos pueden ver el catálogo. Personal autorizado crea/modifica; SOLO Administradores pueden eliminar
    match /products/{productId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // PEDIDOS Y VENTAS: Clientes crean compras web; Empleados y Admins leen/cobran; SOLO Administradores pueden eliminar ventas
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // TURNOS Y CORTES DE CAJA: Cualquier empleado o administrador puede abrir turno, registrar feria/gastos y cerrar turno
    match /cash_shifts/{shiftId} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // CONTADORES ATÓMICOS: Personal autenticado puede incrementar los números consecutivos de folios y SKUs
    match /config/counters {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // CONFIGURACIÓN DE TIENDA: Todos pueden leer (para ver contacto/categorías), solo Administradores pueden editar
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // USUARIOS: Cada usuario gestiona su propio perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
